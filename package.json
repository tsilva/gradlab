  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "gridstack": "12.6.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
