{
  "name": "gradlab-web-assets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test:web": "node --test tests/web_player/*.test.mjs",
    "vendor:web": "node scripts/vendor-web-assets.mjs",
    "build:web": "vite build",
    "check:web": "svelte-check --tsconfig ./tsconfig.json",
    "build:web:fixtures": "vite build --mode fixtures"
