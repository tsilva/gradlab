(version 1)
(allow default)
(deny process-exec)
(allow process-exec (literal (param "PYTHON")))
(deny network*)
(allow network-outbound (remote tcp (param "PROXY_SOCKET")))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc"))
(deny file-write*)
(allow file-write* (literal "/dev/null") (subpath (param "WORKSPACE")))
(deny file-read-data (subpath (param "USER_HOME")))
(allow file-read-data (subpath (param "RUNTIME")) (subpath (param "VENV"))
  (subpath (param "REPO")) (literal (param "CA")) (subpath (param "WORKSPACE")))
(deny file-read-data
  (subpath (string-append (param "REPO") "/.git"))
  (subpath (string-append (param "REPO") "/.local"))
  (subpath (string-append (param "REPO") "/.internal"))
  (regex #"(^|/)[.]env($|[./])")
  (regex #"(^|/)([.]netrc|[.]access[.]local[.]toml)$"))
(allow file-read-data (subpath (param "WORKSPACE")))
(allow file-read-data (subpath (param "INPUT")))
(deny file-read-data
  (regex #"(^|/)[.]env($|[./])")
  (regex #"(^|/)([.]netrc|[.]access[.]local[.]toml)$"))
