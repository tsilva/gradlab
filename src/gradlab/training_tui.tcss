Screen {
    background: #08111f;
    color: #dcecff;
}

Header {
    background: #0d1a2b;
    color: #dcecff;
}

Footer {
    background: #0d1a2b;
    color: #9eb3d4;
}

#training-body {
    padding: 0 1;
}

#run-identity {
    height: 2;
    color: #91a7c7;
    margin-bottom: 1;
}

#training-status {
    height: 1;
    color: #67e8f9;
    text-style: bold;
}

#training-progress {
    height: 1;
    margin-top: 1;
}

#training-progress Bar {
    width: 1fr;

    & > .bar--bar {
        color: #22d3ee;
        background: #203451;
    }

    & > .bar--indeterminate {
        color: #818cf8;
        background: #203451;
    }

    & > .bar--complete {
        color: #34d399;
        background: #203451;
    }
}

#progress-meta {
    height: 2;
    color: #9eb3d4;
    margin-bottom: 1;
}

#metrics {
    grid-size: 3;
    grid-gutter: 0 1;
    height: auto;
    max-height: 10;
    margin-bottom: 1;
}

.metric-card {
    height: 4;
    padding: 0 1;
    background: #0d192a;
    border: round #29415f;
}

.metric-label {
    height: 1;
    color: #91a7c7;
}

.metric-value {
    height: 1;
    color: #e7f3ff;
    text-style: bold;
}

.metric-sparkline {
    height: 1;

    & > .sparkline--max-color {
        color: #a78bfa;
    }

    & > .sparkline--min-color {
        color: #38bdf8 35%;
    }
}

#event-log {
    height: 1fr;
    min-height: 4;
    background: #0b1626;
    color: #cfe1fa;
    border: round #29415f;
}

Screen.-medium #metrics {
    grid-size: 2;
}

Screen.-narrow #metrics {
    grid-size: 1;
    max-height: 8;
    overflow-y: auto;
}

Screen.-narrow .metric-card {
    height: 3;
}

Screen.-narrow .metric-sparkline {
    display: none;
}

Screen.-short #event-log {
    display: none;
}
